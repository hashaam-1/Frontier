# FRONTIER 4 — copy this file to `.env` and fill in the keys you have.
# `.env` is where your keys live. Never share it, never commit it, never paste it into a chat.
#
# You do NOT need every service. Any feature whose key is missing is shown in red in
# Options, and everything else still works. The usual setups:
#   Algrow + WaveSpeed ...... everything (recommended)
#   WaveSpeed only .......... voice, pictures, YouTube footage, photos, objects, Vox scenes
#   kie.ai + a voice ........ pictures and YouTube footage on kie, voice on Algrow / WaveSpeed / ai33
# Links to all of them are on the Whop page.

# ── ALGROW — voice (ElevenLabs), pictures (gpt-image-2), YouTube search + footage logging ──
ALGROW_API_KEY=

# ── WAVESPEED — photo spotlight, real objects, depth pop, Vox scenes;
#    also voice (ElevenLabs v3), pictures (Seedream) and YouTube footage (Gemini) ──
# wavespeed.ai -> Dashboard -> Access Keys. Paid per run from a prepaid balance.
WAVESPEED_API_KEY=

# ── KIE.AI — pictures, Claude, and YouTube footage through Gemini ──
KIE_API_KEY=

# ── GOOGLE GEMINI — YouTube footage logging straight from Google (a free tier exists) ──
# aistudio.google.com -> Get API key
GEMINI_API_KEY=

# ── AI33 — voice, if you already use it ──
AI33_API_KEY=
AI33_VOICE_ID=

# ── PEXELS — stock footage (free, instant, no card): https://www.pexels.com/api/ ──
PEXELS_API_KEY=

# ── SCRIPTS ───────────────────────────────────────────────────────────────
# "claudecode" writes scripts through the Claude Code you already have — no extra key.
# "anthropic" calls the API directly and needs ANTHROPIC_API_KEY.
CLAUDE_PROVIDER=claudecode
SCRIPT_PROVIDER=claudecode
ANTHROPIC_API_KEY=

# ── WHICH SERVICE DOES WHAT (optional) ────────────────────────────────────
# Empty = the first service with a key: Algrow, then WaveSpeed, then ai33 / kie.
# A style file can also name its own voice provider.
VOICE_PROVIDER=
IMAGE_PROVIDER=
# ElevenLabs model on Algrow. Keep v3: it performs the [pause] / [whispering] tags scripts use.
ALGROW_TTS_MODEL=eleven_v3
ALGROW_IMAGE_MODEL=gpt-image-2
# One voice for every channel (normally each style file has its own):
ALGROW_VOICE_ID=
# The voice name used when WaveSpeed speaks (ElevenLabs v3 voices: Brian, Alice, ...):
# WAVESPEED_VOICE=Brian
# WAVESPEED_IMAGE_MODEL=bytedance/seedream-v4

# ── YOUTUBE FOOTAGE (optional) ────────────────────────────────────────────
# Path to a yt-dlp you installed yourself, if it isn't found automatically:
# YTDLP_BIN=
# Gemini model for footage logging with GEMINI_API_KEY (default: the newest Flash that answers):
# GEMINI_MODEL=gemini-3.8-flash

# ── OPTIONAL ──────────────────────────────────────────────────────────────
# FRONTIER_PORT=7860
# VIDEO_W=1920
# VIDEO_H=1080
# FPS=30
# Frontier watermarks nothing. For your own corner QR, drop it at assets/qr.png and set 1.
# QR_ENABLED=0
